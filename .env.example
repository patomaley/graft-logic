# Enquiry delivery — set on Vercel (Project → Settings → Environment Variables).
# Prefer Resend. Or use FORM_ENDPOINT (Formspree / Getform) to ship before Resend.

# --- Option A: Resend ---
RESEND_API_KEY=
CONTACT_TO=
# Optional verified sender (defaults to Resend onboarding address in dev)
# RESEND_FROM="Graft Logic <hello@yourdomain.com>"

# --- Option B: Form endpoint fallback (used first if set) ---
# FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
# FORM_ENDPOINT=https://getform.io/f/xxxxxxxx
