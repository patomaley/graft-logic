# Graft Logic enquiry → Google Form (owned by the Graft Logic Google account).
# Set these on Vercel → Project → Settings → Environment Variables.
# Get entry IDs from the form HTML (name="entry.XXXXXXXX").

GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/FORM_ID/formResponse
GOOGLE_FORM_ENTRY_NAME=entry.000000000
GOOGLE_FORM_ENTRY_BUSINESS=entry.000000000
GOOGLE_FORM_ENTRY_EMAIL=entry.000000000
GOOGLE_FORM_ENTRY_PHONE=entry.000000000
GOOGLE_FORM_ENTRY_COMMENT=entry.000000000
